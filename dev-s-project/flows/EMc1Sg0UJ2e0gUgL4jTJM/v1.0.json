                "sampleData": {},
                "sourceCode": {
                  "code": "export const code = async (inputs) => {\n  const result = {};\n  const records = inputs.dr.payload.onlineCreditControlRecord.creditControlRecords || [];\n  for (const rec of records) {\n    const treeFields = rec.creditControlRecord.treeDefinedFields || [];\n    for (const param of treeFields) {\n      if (\n        param.parameterID === \"REMARK\" &&\n        param.parameterValue &&\n        typeof param.parameterValue.string === \"string\"\n      ) {\n        const key = param.parameterValue.string;\n        if (!result[key]) {\n          result[key] = {\n            \"name\": key,\n            \"value\" : 0\n          };\n        }\n        result[key][\"value\"] = (result[key][\"value\"] || 0) + 1;\n      }\n    }\n  }\n  // Convert result object to array of sub objects\n  return Object.values(result);\n};",
